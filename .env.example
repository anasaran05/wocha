# ============================================================================
# WOCHA — Environment Configuration
# ============================================================================

# Supabase Credentials (from Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Cloudflare R2 Asset Storage (from Cloudflare Dashboard -> R2)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=wocha-assets
NEXT_PUBLIC_R2_DOMAIN=https://cdn.wocha.com

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Transactional Email (Resend / SMTP / Postmark)
RESEND_API_KEY=re_your_api_key
FROM_EMAIL=atelier@wocha.com

# Courier Credentials
DELHIVERY_API_KEY=your_delhivery_token
SHIPROCKET_EMAIL=your_shiprocket_email
SHIPROCKET_PASSWORD=your_shiprocket_password
COURIER_WEBHOOK_SECRET=wocha_webhook_secret_key
